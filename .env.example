# Configuración de Docker Compose. Es opcional: sin .env todo tiene un valor por omisión que sirve en tu equipo.
# Para cambiar algo, copia este archivo como .env (no se sube a git).

# Contraseña de PostgreSQL. Se fija la primera vez que se crea la base de datos: para cambiarla después hay que
# borrarla con `docker compose down -v`. En tu equipo la base solo acepta conexiones locales y guarda catálogos
# públicos del SAT; si publicas la app, pon una contraseña propia (solo letras, números y guiones).
POSTGRES_PASSWORD=comprobante-dev

# Puertos en tu equipo, distintos a los de Mediateca para poder correr los dos proyectos a la vez. La app se abre
# en http://localhost:WEB_PORT. La API (con su documentación en /api/scalar) y PostgreSQL solo aceptan conexiones
# de este equipo, para `npm start`, para `dotnet run` y para herramientas de base de datos.
WEB_PORT=8081
API_PORT=5081
DB_PORT=5435

# Zona horaria del contenedor de la API (nombre de la base de datos tz).
TZ=America/Mexico_City

# Production por defecto.
API_ENVIRONMENT=Production
